# ===== Supabase =====
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public kulcs>

# Emelt jogosultságú kulcs (a régi service_role, vagy az új secret key).
# SZERVEROLDALI: soha nem kerülhet a kliensbe, és nem kaphat NEXT_PUBLIC_ előtagot.
# A Vercel a SERVICE_ROLE szót tartalmazó nevet nem engedi Secretként menteni,
# ezért itt SUPABASE_ADMIN_KEY a neve.
SUPABASE_ADMIN_KEY=<service_role JWT vagy secret key>

# ===== Titkosítás =====
# openssl rand -base64 32 — a NAV hitelesítő adatok titkosításához.
CREDENTIALS_ENCRYPTION_KEY=<32 bájtos base64 kulcs>

# ===== AI-kiolvasás =====
ANTHROPIC_API_KEY=<kulcs a console.anthropic.com-ról>
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== NAV Online Számla =====
# A NAV_SOFTWARE_ID pontosan 18 karakter: 0-9, A-Z és kötőjel.
NAV_SOFTWARE_ID=HU-000000000000000
NAV_DEV_NAME=<fejlesztő neve>
NAV_DEV_CONTACT=<fejlesztő e-mail-címe>
