# ===== Supabase =====
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public kulcs>

# SZERVEROLDALI kulcs — soha nem kerülhet a kliensbe
SUPABASE_SERVICE_ROLE_KEY=<service_role kulcs>

# ===== Titkosítás =====
# openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=<32 bájtos base64 kulcs>

# ===== AI-kiolvasás =====
ANTHROPIC_API_KEY=<kulcs a console.anthropic.com-ról>
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== NAV Online Számla =====
NAV_SOFTWARE_ID=HU-000000000000000
NAV_DEV_NAME=<fejlesztő neve>
NAV_DEV_CONTACT=<fejlesztő e-mail-címe>
